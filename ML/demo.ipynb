   "source": [
    "SIZE = 100000\n",
    "\n",
    "car = np.random.choice([1,2,3], size=SIZE)\n",
    "player_choice = np.random.choice([1,2,3], size=SIZE)\n",
    "\n",
    "count = 0\n",
    "for i in range(SIZE):\n",
    "    if car[i] == player_choice[i]: count += 1\n",
    "\n",
    "print(count/SIZE)"
   ]
