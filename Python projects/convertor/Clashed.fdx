<FinalDraft DocumentType="Script" Template="No" Version="1"><TitlePage><Content><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text Style="AllCaps">Clashed</Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text Style="">Love?</Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text>Written by</Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text>Adithya Iyer</Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text> </Text></Paragraph><Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.74" SpaceBefore="0" Spacing="1" StartsNewPage="No"><Text></Text></Paragraph></Content></TitlePage><Content><Paragraph Type="Scene Heading"><Text Style="">INT. LIVING ROOM, 149/E, BADARPUR, NEW DELHI - AFTERNOON</Text><Text Style=""> - APRIL 25</Text></Paragraph><Paragraph Type="Action"><Text Style="">A door creaks open. In walks </Text><Text Style="Bold">ADITHYA</Text><Text Style=""> (17, Indian, student – Grade 12, nicknamed Appu), still in his school uniform. He throws his backpack onto the sofa, barely missing the small coffee table in front of it. Right across, the TV sits, switched off. He </Text><Text Style="Bold">plops down</Text><Text Style=""> onto the sofa, stretching out like he’s melting into it. To his left, an </Text><Text Style="Bold">open kitchen</Text><Text Style=""> blends into the living space.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(loud, exhausted, half-groaning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Mom, what's there for lunch? I am starving!</Text></Paragraph><Paragraph Type="Action"><Text Style="">A lady can now be spotted from the room, working in the kitchen. Mother (39, Indian, Homemaker) can be seen cooking something on the gas stove. She is dressed in a suit-salwar - Indian clothing.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(without looking, playful but dry)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Is that the Gen-Z method of saying you're home now, Appu?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grumbling, under his breath)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Not again...</Text></Paragraph><Paragraph Type="Action"><Text Style="">MOTHER walks in, setting a </Text><Text Style="Bold">plate of rice with paneer gravy</Text><Text Style=""> on the coffee table. </Text><Text Style="Italic">Not his favorite, but decent.</Text><Text Style=""> She sits beside him, dusting her hands on her dupatta.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You’re not touching lunch until you change and freshen up. You wouldn't have been acting this way had your dad been here, would you?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mutters, walking offscreen)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, yeah...</Text></Paragraph><Paragraph Type="Action"><Text Style="">ADITHYA groans but drags himself offscreen. A few moments later, he reappears in </Text><Text Style="Bold">a loose T-shirt and shorts</Text><Text Style="">, hair still </Text><Text Style="Bold">messy and uncombed</Text><Text Style="">. The TV is on now, playing the </Text><Text Style="Bold">news</Text><Text Style="">—something about </Text><Text Style="Bold">space.</Text><Text Style=""> His eyes light up.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(suddenly alert, pointing at the screen)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hey, that’s Neil deGrasse Tyson! Arjun and I binge-watch his space videos all the time.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not really interested)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ah, yes. You two space folks, your food is getting cold here, back on Earth.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn't seem too bothered by his mother's comment. His exhaustion vanishes. He nearly jumps onto the sofa, eyes glued to the TV.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">At least look at your plate while eating.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn't pay much heed to his mother's command, and she lets it so - </Text><Text Style="Italic">for now.</Text><Text Style=""> She finishes her lunch in 5 minutes, getting up only to notice that he has barely eaten anything. She is used to it now, and just walks away offscreen to the kitchen.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs, watching him, then shakes her head with a half-smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">One day, you'll forget to breathe watching this space stuff.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Right about now, the introductions to Neil (and some other of his colleagues) have been finished and the event is about to start - something about some info that'll later be released by NASA as an official press release about some space event.</Text></Paragraph><Paragraph Type="Character"><Text Style="">TV ANCHOR</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Neil)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, what's this space event you mentioned about which the press release will be released by NASA?</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(calm intellectual tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">My colleagues and I have found some unusual activity in the cosmos. There is a good and a bad news.</Text></Paragraph><Paragraph Type="Character"><Text Style="">TV ANCHOR</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(formal tone with a slight humor)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Let's hear the good news first — keep us smiling, Neil.</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The multiverse theory we've been working on is true. It works.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(jolly, excited)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I knew it, I knew it... Those fools in my club making fun of the multiverse theory. I'll show them now.</Text></Paragraph><Paragraph Type="Character"><Text Style="">TV ANCHOR</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(amazed)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Wow, that's an impressive step, folks, we've taken the first step in understanding the configuration of the universe.</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(serious, slightly hesitant)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">But the bad news... We're not alone</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, locking eyes with the camera)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And no universe is ever meant to collide with another... But ours is.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(furrowing his brows, trying to make sense of it)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Wait… but that shouldn’t even be possible. Universes exist in different dimensions, completely separate from each other. A collision shouldn’t affect us… at most, we might catch glimpses of something — but nothing major, right?</Text></Paragraph><Paragraph Type="Action"><Text Style="">The TV anchor stiffens, the edges of his triumphant smile twitching downward. He nods slowly, pretending to absorb Neil’s words—but his unfocused eyes betray him. His knowledge is thin, and his shock is thick. Even the scientist notices that.</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(chuckling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I see you're having trouble. Don’t worry—it’s not a catastrophe. </Text><Text Style="Italic">At least, as far as our simulations worked.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(amused, barely paying attention to the concern in Neil’s voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">"Well, would you look at that</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">two correct </Text><Text Style="">deductions</Text><Text Style=""> in one day. That’s got to be a record."</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shrugs, still grinning)</Text></Paragraph><Paragraph Type="Character"><Text Style="">TV ANCHOR</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't scare </Text><Text Style="Italic">us</Text><Text Style="">, Neil. So, what will happen?</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">As far as our equations are, if the colliding universe is from a very close branch as our universe in the grand chart of parallel universe bifurcations, only few of us would see any difference. We might see and hear a few things for as long as the collision occurs, which should be about a few days or weeks.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(matter-of-factly tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It very well might just be the universes passing right through each other with no impact at all.</Text></Paragraph><Paragraph Type="Character"><Text Style="">TV ANCHOR</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, voice dropping slightly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And... if it’s not from a close branch? Are we in danger?</Text></Paragraph><Paragraph Type="Character"><Text Style="">NEIL DEGRASSE TYSON</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales, thinking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Truth is… we don’t know. We still barely understand how our own universe behaves—let alone another colliding into it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just then, there's a blip sound from the on-screen monitor as NASA finally publishes the official press release of the upcoming occurrence.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya exhales sharply, shaking his head as the anchor keeps talking. He picks up the remote and flicks off the TV mid-sentence.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering, unimpressed, but excited)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They’ll make a circus out of this.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Without a second glance at the screen, he gets up</Text><Text Style="">, pacing across the living room.</Text><Text Style=""> His half-eaten lunch sits forgotten as he strides toward his room</Text><Text Style=""> </Text><Text Style="">— </Text><Text Style="">ignoring the</Text><Text Style=""> media’s</Text><Text Style=""> circus</Text><Text Style="">. </Text><Text Style="">He needs real data. </Text><Text Style="">He needs NASA’s document.</Text></Paragraph><Paragraph Type="Action"><Text Style="">His phone buzzes. For a split second, he thinks—maybe it’s </Text><Text Style="Bold">her.</Text><Text Style=""> But it’s just a news update. </Text><Text Style="Bold">"NASA confirms upcoming cosmic event—What does this mean for us?"</Text><Text Style=""> He snorts, shaking his head. If only figuring out love was as easy as physics.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. ADITHYA'S ROOM, 149/E, BADARPUR, NEW DELHI - EVENING - </Text><Text Style="">APRIL 25 (SAME DAY)</Text></Paragraph><Paragraph Type="Action"><Text Style="">A modest room, one wall lined with a tall bookshelf packed with books from top to bottom. Another wall is covered with his printed poems, some taped, others boldly scrawled in permanent marker. Opposite it, a medium-sized desk holds his laptop, where Adithya sits, browsing through the NASA press release. His phone rests face-up beside him, its dark screen reflecting the glow of the screen. </Text><Text Style="">The room is spacious but lacks a bed, leaving the open floor untouched.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya leans forward slightly, scrolling through the document, his fingers drumming absently against the wooden desk. His brows knit together, eyes scanning the text with quiet focus.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just as he smirks at something strange in the NASA Press Release, he hears a voice calling out to him from the living room.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sarcastic)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Will you come in here for a moment, Appu?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering under breath)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Why can't they let me work?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He nudges his desk forward, sighing as he rises from his chair. With a reluctant stretch, he heads offscreen to the living room.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(as his footsteps fade out)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Care to explain why half of your lunch is here?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(</Text><Text Style="Italic">hesitant, realizing his mistake)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Uh... I was totally about to eat that.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(deadpan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah? Go feed it to the dogs.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs, shaking her head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And you better wash your plates. Forget it — I'll do it myself. Just go.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya’s footsteps fade in as the door creaks open. He sinks into his chair, nudging the table forward, eyes already locked back on the NASA press release.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(cracking his fingers)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Now, where was I?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(focused completely on a single line of the document)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Huh… that doesn’t add up. How did NASA even predict this? No theory can pinpoint another universe’s position, let alone a collision…</Text></Paragraph><Paragraph Type="Action"><Text Style="">He flips back a few pages, scanning the data, fingers tapping absently against the desk.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering, realization creeping in)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Unless...</Text></Paragraph><Paragraph Type="Action"><Text Style="">His breath quickens. He yanks open a drawer, grabs a rough notebook, and starts scribbling—breaking down the anomaly in NASA’s findings.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mumbling to himself, excitedly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Of course! No theory so far can map a parallel universe—we don’t even know how to define the 'space' between them. So how did NASA predict a collision?</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It could be a bluff... but their data checks out. Which means—</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, scanning his calculations)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They’re not going to collide...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(beat, double-checking, swallowing hard)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They already have. We’re in the middle of it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya pulls out his phone, opens WhatsApp, and clicks on the most recent chat - Aryan, his best friend.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(texting to Aryan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Meet me at HIS apartment in 10 to 20 mins. If you don't want to miss out on something great, that is.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya stands up, nudging the table back. He swaps his shorts for joggers. As he packs his notebook, laptop, and pen, his fingers brush against a small keychain — something he bought for </Text><Text Style="Bold">her</Text><Text Style="">, but didn't have the courage to do so. He exhales, tucking it back in without a second thought. Maybe later. He walks offscreen, the door creaking open, to go to HIS apartment. And is seen by Mother just as he is about to leave the house.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Where are you going, smarty-pants?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA (O.S.)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Rahul's apartment.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(placing her hand on her temples)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He's older than you. Show some respect.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(commanding tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And you should be home by 7:30.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The house outer door is heard opening, as Adithya leaves for Rahul's apartment.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Scene Heading"><Text Style="">INT. LIVING ROOM (RAHUL'S APARTMENT), 160/J, BADARPUR, NEW DELHI - </Text><Text Style="">APRIL 25 (</Text><Text Style="">LATER</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">A small, cramped space, barely enough for one, let alone three. Books spill from overstuffed shelves onto the floor, table, even the kitchen counter. A whiteboard leans against the wall, covered in half-finished equations and stray notes.</Text></Paragraph><Paragraph Type="Action"><Text Style="">On the desk, a laptop hums—half-screen code, half chemistry notes. Beside it, a half-eaten Maggi bowl and an abandoned coffee mug, long gone cold.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The tiny open kitchen is a mess—spice bottles scattered, a single plate with crumbs by the sink, just enough space for a gas stove.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The air lingers with old books, instant noodles, and stale coffee. A standing fan hums, pushing warm air. One bulb’s been fused for weeks, but Rahul hasn’t bothered.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A knock on the door. Rahul drags himself to the door, pulling it open.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(from the door)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yo, it's me.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(door opens)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">How ya doin'?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhausted)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Dragging by. Where's Aryan?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul moves to the side, letting Adithya in.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(facepalming at the mess)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He'll be dropping here soon. Read the NASA press release?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn't bother asking about the mess. It's a common thing now.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shocked)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA made a press release?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul pulls out his phone, scrolling fast. He didn't read the actual information, but just checked for notifications.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(groaning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Damn it. Must've been during class—cleared my notifications without checking.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul's phone rings - he just declines. Adithya notices "Dad" on the phone, wondering why he'd decline his father's call, but doesn't intrude to ask why.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(excited, eager)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, what was it about?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Collision of our universe with another parallel one.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(skeptical)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Right. And next, you'll tell me the moon’s crashing into us too.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Actually? They said it could happen anytime. Any moment.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(still refusing to believe)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Stop joking around. Anyhow it's not like it's too much to be afraid about. Most likely, the two universes would just pass through each other. We've already gone over this in our imaginary events. You came all over here just for that?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(leaning in, smug)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA’s bluffing. And my numbers prove it.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shocked)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Are you for real? You expect me to believe your calculations more than NASA's?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They say, equations speak louder than words, don't they?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(deadpan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">No, they don't! It's "actions speak louder than words".</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya stays quiet, shoves some books aside, and drops onto the floor. As he pulls out his laptop, a keychain slips out with it. Rahul notices.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Still clinging onto it, huh? Just give it and be over with it, idiot!</Text></Paragraph><Paragraph Type="Action"><Text Style="">A knock interrupts their conversation, not that Adithya wanted to reply about that. He immediately put back the keychain inside his bag, taking out his rough notebook as well.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I'll open it. Probably Aryan.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya hands him the laptop, after opening the NASA press release on it, as he reads through it. Adithya gets up and paces over to the door, pulling it open, as a slightly healthy boy - Aryan comes into view.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">How many times do I have to tell you? You can’t just text ‘SHOW UP’ and expect me to drop everything!</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grinning, shaking his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And you wonder why you're single.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Says the guy with the keychain still in his bag? Right, Rahul?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">She tied me a Rakhi, man. What am I supposed to do?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul exhaled quietly, eyes locked on the document—reading with even more focus than before. Aryan shrugged. Silence. He walked over across the room, noticing something written on the whiteboard.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He reads it aloud.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(reading)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Mr. Sharma is a K-NH2.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(groaning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Isn't that too old a pun, Rahul? Hardly funny these days.</Text></Paragraph><Paragraph Type="Action"><Text Style="">They all got it instantly — too basic to miss. '-NH2' reads as 'amine,' and 'K-NH2' sounds just enough like ‘ka-amine’—which, in Hindi, isn’t exactly polite. A joke every noob thinks they’ve invented first.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, some of my friends had dropped over. They might've written it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan glances around the room, unbothered by why he was summoned. He knows Rahul is working on it, and Aryan's job anyhow comes into play when it's rigorous mathematics.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya settles onto the floor beside Rahul, lost in Rakshabandhan nostalgia.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A good half an hour passes.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hey, the press release looks all good and perfect to me.</Text></Paragraph><Paragraph Type="Action"><Text Style="">No reply. Adithya is still lost in his world of that day when he was tied the Rakhi by her. Too lost to hear. </Text><Text Style="Italic">Until he gets a smack on his head by Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sitting up straighter, clearing his throat)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Right. </Text><Text Style="">Where were we?</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Did you finish reading it?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, and I don't see any problem.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya takes back his laptop, scrolling to the line that caught his attention.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Read it, will you?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(proceeding to read himself)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">"Current models lack the capability to determine, even roughly, the distance or relative position of the potential colliding universe."</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking between them)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You’re telling me you still don’t see the problem?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan and Rahul look at each other, confused at what the problem is.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(leaning back, smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Look, Mr. Space Guy, are you gonna enlighten us, or should we beg Your Majesty for the royal explanation?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes, smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Let me dumb it down for the two of you poor folks.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(a slightly serious explanation)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If NASA has no ways of mapping the distance between two universes, which is a right claim as I checked out every science journal, how did it even figure out its trajectory or figure out it's going to collide? And the release doesn’t even hint at how they figured it out.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(finally getting it)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So the collision’s already happening — it’s in progress as we speak, right? You ran the numbers?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(excited)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Of course he did. That's why he summoned us.</Text></Paragraph><Paragraph Type="Action"><Text Style="">I nod, pulling out my rough notebook, flipping to the calculations—built on principles Aryan and I had theorized, mixed with some universally accepted ones.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(excited)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The math checks out — the two universes are barely apart, off by maybe an order of 1 or even less. And get this… for over a week, they’ll be phasing right through each other. A perfect overlap. Every place, every structure… even the people. Synced.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ah, and it’d stay locked for a while — it stabilizes the parallel universes when treated as a system.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(connecting the dots)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, every particle exists in both the universes at the same time...</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(ominous)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Probably.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(loving their excited reactions)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yup. Aryan, check the calculations — especially my vector analysis. See if anything feels off.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan strokes his beard, eyes narrowing — either questioning why NASA would even hide this or already running the math in his head.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan and Rahul double-check the math, scanning for errors.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Minutes slip by.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya's eyes accidentally fall on the clock. 7:40.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(alarmed)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Holy cow! It's 7 40 already?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(glancing at his watch, groaning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Crap. I was supposed to be home at 7:15.</Text></Paragraph><Paragraph Type="Action"><Text Style="">They scramble up, grabbing their bags. Aryan bumps into the table, knocking over a book.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rushing to the door)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Rahul, think you can run a simulation? Map out the first day of the overlap — use your college’s supercomputer if you have to.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking at the schedule)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, my laptop can’t handle something this big. I’ll text you when it’s done, but expect a 3-4 day delay — professors have the supercomputer tied up.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's good enough.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turning to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Send me your rough calculations over WhatsApp once you reach home... I'll have my dad look over them.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(joyful, to Aryan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Sure, now, I should rush. You coming as well, right?</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two exit the apartment walking offscreen.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul pulls out his phone again, his fingers hovering over his Dad's WhatsApp profile. But he closes the app and gets back to working on the college assignment.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. SECTION S1, GRADE 12, XYZ SCHOOL, FARIDABAD, HARYANA - MORNING - </Text><Text Style="">APRIL 26 (</Text><Text Style="">NEXT DAY</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">The classroom hums with activity, though the crowd is thinner with the festival approaching. At the front, a fresh blackboard and a teacher’s desk stand ready. Lectures haven’t begun, so students mill about. Aryan steps in, scanning the room. The moment he spots Adithya, he walks straight toward him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(voice barely above a whisper, eyes downcast)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He’s gone, man... Rahul’s dad.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What—? When? We saw Rahul last night—he didn’t say a word.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He was supposed to go home </Text><Text Style="">yesterday...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(</Text><Text Style="">pauses, swallows hard</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">B</Text><Text Style="">ut since we stopped by, he stayed back.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(a beat, hands tightening into fists)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Around 9, his dad left home to pick him up... but never made it.</Text><Text Style=""> I didn’t find out until this morning</Text></Paragraph><Paragraph Type="Action"><Text Style="">A heavy silence lingers between them—neither sure what to say, both facing a conversation they’ve never had before.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(staring at Aryan, at a loss for words)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Goddamn it...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(inhales sharply, rubs his face, shakes his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So where is he? Rahul, I mean.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking at the rest of the class)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He’s at the hospital. We should go after school.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We should go now.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales, voice low, barely amused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, because my dad owns the school, right? I can come and go whenever I want...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shakes head slightly, eyes distant)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Look, we should just wait...</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sharp glare, dead serious)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We should go now.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(hesitates, glancing around, then sighs)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">How? Fake being sick?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(dryly, unimpressed)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah. Real simple.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolls his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It's not going to work.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales, uneasy)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Anyhow, my dad's there with him. He asked me not to worry.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turns to look at Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, all we should do right now is wait for school to end, clear?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Not able to find any flaw in the plan, Adithya looks away in angered grief.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering, frustrated)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">First the collision, and now this... what the hell's wrong with the universe?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Something stirs in Aryan. He hesitates, reading the room, measuring the weight of the moment.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales, trying to calm himself down before he finally manages to speak.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(calm, serious)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The collision is about 6 to 7 months away. We’ll need the simulation for precise timing, but my rough estimate from last night puts it in that range.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(detached, hardly interested)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, thanks.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(gulps)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Rahul’s dad died, right? So... there must be some other universe where he’s still alive. Where we never stopped by, where Rahul made it home on time, where his dad is...</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan’s fingers twitch — like he wants to say something, but the words never come. Instead, he just got up and walked out, slipping past the door and exiting offscreen.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The chatter and laughter fade into the background.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A student passed, fist-bumping Adithya. He returned it instinctively, without looking up.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just before the lecture began, an announcement echoed through the room.</Text></Paragraph><Paragraph Type="Character"><Text Style="">TEACHER 1</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Due to low attendance, Sections S1 and S2 will be merged — same for C1 and C2. Both will follow the S1 and C1 schedules, respectively.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering to himself)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, leave it to the school to make a bad day worse.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(cracking his fingers, tapping a foot impatiently)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I guess all I can do is just wait.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A few minutes later, S2 students trickle in — Aryan slips in with them, drying his hands with a handkerchief.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn't really know all the students of S2 by names, but he recognizes a few.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He spots a familiar girl settling into the seat in front of him. He glances at Aryan, catching the faint blush creeping in. He exhales, debating for a second, then leans in as Aryan comes to sit down right next to Adithya.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(whispering, dry, forced smirk)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Looks like we've got Miss Nature for company. </Text><Text Style="Italic">Perfect </Text><Text Style="">timing!</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(glares at him)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Seems like a good time to flirt, doesn't it?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(crossing his hands, slightly aloud)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Look, I don't want to sound mad, but you're the one who said all we can do is wait.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(louder, turning a few heads)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That doesn't mean flirting.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(a beat, exhales, rubbing his temples, voice dropping)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Just - don't act like nothing happened.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just before the first class started, Adithya slipped out of the classroom, and never returned to the class the whole day.</Text></Paragraph><Paragraph Type="Action"><Text Style="">After school, when Aryan finally made it to the hospital, he found Adithya already there—sitting next to Rahul, quietly listening to Aryan’s dad.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. SECTION S1, GRADE 12, XYZ SCHOOL, FARIDABAD, HARYANA - NOON - </Text><Text Style="">APRIL 28 (</Text><Text Style="">TWO DAYS LATER</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan and Adithya sit in their usual seats, the classroom now merged once again with S2. Their homeroom teacher sits at her desk, overseeing the scattered conversations and lunch breaks.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The tension that once lingered between Aryan and Adithya seems to have faded—or at least, that's how it looks.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(casually)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Rahul texted my dad yesterday.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Not you? That's </Text><Text Style="Italic">weird.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He wants us there after school—looks like he cracked the simulation.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(excited but confused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Didn't he say there’d be a 3 to 4-day delay? And why text your dad?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused himself, shrugs)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Who knows? Looks like he worked overnight to fit into the supercomputer’s tight schedule.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(even more confused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That doesn't seem like him at all.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Amidst the exchange, Aryan spots a girl coming towards him. Or rather, towards </Text><Text Style="Italic">Adithya.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(continuing without noticing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He left me on 'read' - didn't even bother to reply -</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(interrupting, whisper)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Bold+Italic">She</Text><Text Style=""> is coming.</Text></Paragraph><Paragraph Type="Action"><Text Style="">At the word, Adithya turns around, to find Sakshi standing right behind him - the girl who had tied him </Text><Text Style="Bold">the rakhi</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(faster beats, slight blush)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hi. What happened?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking, overly formal)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If you don’t mind, your </Text><Text Style="Italic">loyal servant</Text><Text Style=""> and I were in the middle of something. So, it'd help if your hurry up.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(biting his anger at Aryan's interruption)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't worry about him.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(politely)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What happened?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sweet voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Could you let the bus driver know I won’t be taking the bus this afternoon?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(slightly disappointed, but hiding it)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Your dad's coming to pick -</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pausing mid-statement)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, that's none of my business. Cool, I'll tell him.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(forced chuckle)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It just means more space in the bus...</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Thanks... I guess.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Aryan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And he's not my servant. Just a friend.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(snapping right back)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, or as some call it - bro-zoned.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi seems to have not heard it. She walks away to her friends circle.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(louder, making sure she hears)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Same thing as ‘servant,’ you know...</Text></Paragraph><Paragraph Type="Action"><Text Style="">She doesn’t turn back. Doesn’t acknowledge it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan scoffs, shaking his head as he turns to Adithya.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not bothering to lower his voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">She's a witch, I tell you. Plays the tough game.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(hushed firm)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">She's </Text><Text Style="Italic">not</Text><Text Style=""> a witch.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And you, my best friend...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sigh, then smirk)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You're such a </Text><Text Style="Italic">loyal slave.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The school classes breeze through, Adithya drifting into daze - while accidentally staring at Sakshi - a few times, before being slapped awake by Aryan.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. LIVING ROOM (RAHUL'S APARTMENT), 160/J, BADARPUR, NEW DELHI - EVENING - </Text><Text Style="">APRIL 28 (</Text><Text Style="">SAME DAY</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">T</Text><Text Style="">he room is worse than before</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">coffee cups everywhere, empty Maggi bowls stacked on the table. The laptop teeters at the edge, somehow defying gravity.</Text></Paragraph><Paragraph Type="Action"><Text Style="">At the whiteboard, Rahul scribbles equations, dark circles carved under his eyes. Judging by the mess, he hasn’t slept in days.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The front door reads: "DON'T COME IN."</Text></Paragraph><Paragraph Type="Action"><Text Style="">A firm knock is heard as Rahul drags himself towards the door, opening it. There stand Aryan and Adithya.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(voice rough, barely standing straight)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Come in, come in.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two see the entire mess. They expected messy — but not this.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taken aback)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What have you done to yourself?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(forced chuckle, waving it off)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">This? It’s normal. College life. Sleepless nights, bad eating, the works. You’ll get used to it.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shocked, alarmed)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I don't see any of your friends looking half-dead.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul doesn't even bother reacting to Adithya's comment, almost as if he didn't hear it.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(hoarse voice, rough)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Come on, I'll show the simulation. I managed to book the supercomputer for an hour.</Text></Paragraph><Paragraph Type="Action"><Text Style="">There is no excitement in their pace. </Text><Text Style="">Even they’re dragging themselves now, their excitement fading into worry.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(feigning excitement)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Did it work? Was my hypothesis right?</Text></Paragraph><Paragraph Type="Action"><Text Style="">No reply.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(thinking Rahul didn't hear it)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, the calculations are wrong?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(slightly joyful tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">No, they're perfect. Just perfect.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(whispering just to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hey, why is he ignoring you?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused himself, whispering back)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">How should I know? Maybe he didn’t catch it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The three exit offscreen, heading to the college campus.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. COMPUTER SCIENCE LAB, B2A, IIT DELHI, NEW DELHI - LATE EVENING - </Text><Text Style="">APRIL 28 (</Text><Text Style="">SAME DAY</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rows upon rows of PCs stretch across the massive lab—at least a hundred in total. Even at this hour, the place hums with activity. Some students work on coursework, others on projects, heads buried in screens.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul, Aryan, and Adithya step in, barely earning a glance.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(</Text><Text Style="">low, directed at Aryan</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Find seats where it’s quieter.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan and Adithya weave through the crowd, settling in a quieter corner. Rahul steps away to get permission from the lab manager.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(low toned whispers)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He's </Text><Text Style="Italic">still</Text><Text Style=""> ignoring you.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhaling shaking head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Whatever I did, he could at least tell me.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan simply shrugs.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Minutes pass in heavy silence.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul returns, slipping into a seat beside Aryan. He pulls out a pen drive, plugging it in, loading up his simulation in one of the PCs.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The way Rahul moved — like something inside him had already given up — left them silent. Any words of concern died in their throats."</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turning to Aryan while the simulation loads)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I found two things in the last few days. First, the perfect overlap will happen in 6 months and 13 days from now, meaning October 27, and will last for about 2 to 3 weeks.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul coughs. Uncontrollably. Eyes turn toward him, and one of his friends nearby grabs his arm, steadying him before leading him offscreen to the restroom.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Ten minutes crawl by, thick with silence. The simulation finally finishes loading, but neither of them feels at ease.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul returns, looking slightly better — but it’s all surface. The exhaustion, the emptiness, still lingers in his eyes. He slips into his chair, and requests access for the supercomputer using his password in PowerShell.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(faking indifference)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, what was the second thing?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya keeps quiet, realizing that he has been given the signal of being ignored. He just listens.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smiling weakly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA wasn't bluffing.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taken aback)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Huh? But you said Adithya's hypothesis was perfect.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(trying to make some sense)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That only means that NASA </Text><Text Style="Italic">was </Text><Text Style="">bluffing.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul pulls out his phone, loading the NASA Press Release, handing it to Aryan as he continues pushing himself to work on the starting of simulation.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(focused on the PC screen)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Load to the bottom.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan loads to the bottom to find contact information in case of reporting error, submitting complaints or asking doubts. Interestingly, the e-mail provided wasn't an official one, like </Text><Text Style="Italic">kelly.l.garcia@nasa.gov, </Text><Text Style="">but instead a private one, </Text><Text Style="Italic">wethenasa@gmail.com.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Your</Text><Text Style=""> </Text><Text Style="Italic">friend</Text><Text Style=""> sent it to me, wondering if we should report the collision error to NASA.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Both Aryan and Adithya noticed the way he referred to the latter. But they thought of ignoring it anyhow.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taking slow, pained breaths)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA has never put such a thing ever in its documents. I checked every single one.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Something clicks instantly in Adithya's mind, making him forget that he was being ignored.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya's gaze sharpens, reading over the email again. A private email, not a formal one. Not meant for the media. Meant for...</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(excited)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Meaning it's attempted at attracting the scientific minds to solve the problem.</Text></Paragraph><Paragraph Type="Action"><Text Style="">No reply. Rahul is still fighting off errors, trying to stabilize the simulation.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(used to the ignoring by now, processing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So they left the mistake in </Text><Text Style="Italic">on purpose </Text><Text Style="">— as bait. And the private mail as a hint.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(beat, realization deepens)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The media wouldn’t notice. They’re too busy screaming about the collision.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, frowning, voice lower)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">But why? NASA has direct access to the top scientists in the world. Why not just summon them?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya's lips part slightly — then press shut. Enough of being ignored.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flat, rasping)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You overthink the obvious, Aryan.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(coughs once)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA doesn't want their funders to find out that it's desperate.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Silence. Aryan’s mind races as he searches on Rahul’s phone for NASA's funders.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(fast scrolling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Makes sense. Most of those </Text><Text Style="Italic">fat pigs</Text><Text Style=""> investing have recently been shifting their money toward private enterprises.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul nods absently. Adithya lowers his head onto the desk—silent, shut out.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A few moments drag by.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sits back, rubbing his temples, voice dull)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Alright... Let's just run it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The simulation loads into the supercomputer. The parallel universe appears overstuffed, tangled—chaotic. Not the clean, structured world they expected. It doesn’t make sense; the universes differ by less than an order of one.</Text></Paragraph><Paragraph Type="Action"><Text Style="">And, it moves fast. Too fast. Accelerating rapidly.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul’s exhaustion lingers, but something shifts. A flicker of focus.</Text><Text Style="Bold"> A trace of urgency.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul scrubs past the early parts of the simulation, skipping ahead to October 18, 7:00 PM.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The overlap barely lasts a second before the parallel universe swings away</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">then snaps back. It keeps oscillating, like a pendulum, tethered to the overlap position.</Text><Text Style=""> </Text><Text Style="Bold">But the oscillations aren’t slow — they’re near-instant.</Text><Text Style=""> The speeds are so massive that it </Text><Text Style="Bold">almost disappears from one extreme and reappears at the other</Text><Text Style="">,</Text><Text Style="Bold"> </Text><Text Style="">flickering in and out like</Text><Text Style="Bold"> a glitch</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul pauses the simulation. Slowly, he turns</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">not to Adithya, but to Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(piecing it together)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Now, this didn’t happen when I ran a low-quality simulation on my </Text><Text Style="Bold">32GB RAM laptop.</Text><Text Style=""> It just showed the parallel universe </Text><Text Style="Bold">decelerating - without any flicks or oscillations.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(thinking ahead)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Makes sense. But for the oscillations to stop on October 27, </Text><Text Style="Bold">there has to be a damping force at play.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul scrubs ahead to October 27.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The oscillations have almost vanished—no more violent swings, no rapid flickers. What remains is a faint, near-imperceptible tremor, so minimal that the supercomputer barely registers it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul pauses at the exact moment the oscillations </Text><Text Style="Bold">fully stabilize.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(leaning in)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Okay, so your estimation was right... Now we just need to figure out why it’s so much more chaotic than our universe.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two zoom into the parallel universe, hiding their own.</Text></Paragraph><Paragraph Type="Action"><Text Style="">To say it’s abnormal is an understatement—it looks like an infant went wild with paint, smearing colors without reason, without form.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A faint spark flickers in Adithya’s eyes—neither of them notices. Aryan, lost in his own wonder, forgets Adithya is even there.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya rises from his chair — still unnoticed — and moves away, settling next to the guy who had helped Rahul when he was coughing, a noticeable distance from the two.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The guy doesn't mind Adithya seeing him work.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(curious, low-voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What are you doing, </Text><Text Style="Italic">bhaiya?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(small smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It's an assignment task. Something about sorting numbers in an array </Text><Text Style="Italic">the most efficient way.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shrugging, almost self-conscious)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh. I solved it when I started programming a year back. But it was clunky and slow — nowhere near </Text><Text Style="Italic">efficient.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sunil politely nods - much better than Rahul's ignoring.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(trying to small-talk)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, what are you two and Rahul trying to do? He never brings accomplices to the lab...</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya involuntarily twitches at Rahul's name.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(waving it off)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It's </Text><Text Style="Italic">really </Text><Text Style="">nothing. Feels like he only brought me here to ignore me.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhaling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It was my idea, and now I’m the one being shut out.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(faking excitement)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What you're doing is far more interesting, </Text><Text Style="Italic">bhaiya</Text><Text Style="">!</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(chuckling slightly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Really! </Text><Text Style="">You flatter me.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(knowingly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You’re telling me sorting numbers is more interesting than a whole universe colliding?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taken aback)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">How- How did you know?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Rahul used to talk about you two a lot - always called you pure geniuses.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, hesitant)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I don’t know what changed after, well...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(avoiding mentioning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Whatever happened, it must’ve hit him hard. Maybe that’s why he’s avoiding you.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya stays quiet, too drained to argue. Sunil glances at him, then pats his back.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grinning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don’t sulk, </Text><Text Style="Italic">chhote.</Text><Text Style=""> Things will fall back in place.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(playfully, reassuring)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And if they don’t, I’ll knock some sense into Rahul myself.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya chuckles slightly, his mood lifting just a little.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He notices the two still bent over the simulation, deep in thought. Sunil follows his gaze.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(amused, knowingly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You already know the answer they’re looking for, don’t you?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirks, stretching slightly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, I do... And they’ve been going in circles for minutes.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(uplifted tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Guess it’s time for Cosmologist Adithya to make an appearance.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sunil watches, impressed by how fast Adithya’s mood shifts.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(chuckling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, we need you, champ!</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grinning, rolling his shoulders)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Might as well keep talking until Rahul snaps and tells me why he’s pissed.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SUNIL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(laughing, shaking his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That’s one way to do it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sunil chuckles at Adithya’s antics, turning back to his work as Adithya slips right back next to Aryan and Rahul.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(bitter, without looking up)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Guess who's back... Mr. Over-smart!</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flat voice, like he’s holding something back)</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul's tone is sharp, almost as if he hates Adithya.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pointing at Rahul)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And you, my dear friend, are ignored.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking at the paused screen)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ask the simulating app to zoom into Earth's orbit in the parallel universe.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul shrugs indifferently, but not having his own solutions follows Adithya's lead.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smug tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Now, hide the trajectory of everything including Earth's. Hide the stars, planets - everything leaving Earth.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A 2D stretched helix forms on the screen.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The Earth revolves around the sun, which revolves around the supermassive black hole in the center of the galaxy. We are seeing Earth right now from the scale of the Galaxy. So, what shape should we expect the Earth's trajectory to be?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">In layman terms, a circular 3D helix.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Slam it into two dimensions, what does it become?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pretending indifference, pointing at the screen)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">This. A 2D stretched helix.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn’t react. He simply waits.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan catches on immediately.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mock serious, straightening up)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">A stretched 2D helix, </Text><Text Style="Italic">Professor</Text><Text Style="">!</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grinning, milking the moment)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Excellent, my boy! Excellent!</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul's exhausted features push away because of the anger building up.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(snorts, bitter)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh yeah? Why are we slamming them into 2D, huh?</Text></Paragraph><Paragraph Type="Action"><Text Style="">No reaction. Adithya places a hand behind his ear, acting as if to amplify his hearing.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking at Aryan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Did you hear a </Text><Text Style="Italic">stupid rat</Text><Text Style=""> squeal?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">No. But could you explain the reason for slamming into 2D, </Text><Text Style="Italic">Professor</Text><Text Style="">?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(faking irritation)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">These </Text><Text Style="Italic">rats</Text><Text Style=""> keep showing up everywhere.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taking a long breath)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Anyway, the slamming? Well, if you read the first topic on multiverse theory, it says, all parallel universes exist in either different configurations of dimensions or in more or less dimensions...</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(dismissive, interrupting)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Blah, blah, blah...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(voice rising)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Why- Why does it even matter? Why does any of this matter?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(without thinking, snapping back)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Why does it matter, huh? If it doesn't matter, why are you half-dead working on it.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(voice raising)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If it didn't matter, you should've just let the task go to trash after-</Text></Paragraph><Paragraph Type="Action"><Text Style="">He stops. </Text><Text Style="Italic">Too late</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul lashes out at Adithya, pushing him in his chair, failing in efficiency due to Aryan being between them.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(infuriated)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">After what? After my dad died?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(snorts furiously)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Had you not come up with this </Text><Text Style="Italic">stupid</Text><Text Style=""> idea, he wouldn't have, you, piece of </Text><Text Style="Italic">shit.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul stand up. His exhaustion is visible, but it's now replaced with anger. </Text><Text Style="Bold">Pure anger</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya stands. Not backing down.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan sighs, shrugging at their impulsive behavior.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not relaxing one bit)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If it was so </Text><Text Style="Italic">stupid</Text><Text Style="">, why bother? Why didn't you just go home </Text><Text Style="Italic">that evening</Text><Text Style="">?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(something striking in his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Why didn't you pick up </Text><Text Style="Italic">his</Text><Text Style=""> call that day?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul breaks. His mind shatters. He tightens his hand into a fist, and moves it right towards him.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya doesn't even flinch, ready to take it head on.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just as it's about to hit, Rahul's hand is grabbed by Sunil standing right next to the two.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan simply puts his hand in his pockets, and begins walking out of the room, thinking the breakdown is over.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(casual, glancing back from the door)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Cool. That's done. And not much to take from the simulation either. Time to go home, you two.</Text></Paragraph><Paragraph Type="Action"><Text Style="">No reply. Their eyes are still locked.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not even glancing at Sunil, voice low, biting his anger)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I can take his punches. Let the dog bark.</Text></Paragraph><Paragraph Type="Action"><Text Style="">No one else in the room even looks up. Not the students. Not the lab manager. Just another normal night in college.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sunil studies Adithya’s face—the fire in his eyes. Then, he lets go of Rahul’s hand. But he doesn’t step far. Just enough to act if things go south.</Text></Paragraph><Paragraph Type="Action"><Text Style="Bold">Rahul swings</Text><Text Style="Bold"> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">a sharp, angry hit straight to Adithya’s gut. He doesn’t flinch. Doesn’t even try to block. Just takes it.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shaking off the pain, voice sharp)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Sleepless nights and coffee cups don’t make even </Text><Text Style="Bold+Italic">dogs</Text><Text Style=""> strong, informative</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul exhales sharply. Too tired to snap back. Too drained to feel victorious. His anger had given him strength—now, even that is gone.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He swings again. Weaker. And again. Slower. One last time</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">it barely lands.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Then, his body gives up. His legs buckle. He slumps. Crashes </Text><Text Style="">forward.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya catches him before his face smashes onto the ground. Sunil moves in, steadying him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering, barely conscious, words slurring together)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">S-</Text><Text Style=""> </Text><Text Style="">S</Text><Text Style="">o-</Text><Text Style=""> </Text><Text Style="">S</Text><Text Style="">orr—</Text></Paragraph><Paragraph Type="Action"><Text Style="">His voice fades. Unfinished. His eyelids flutter once</Text><Text Style=""> </Text><Text Style="">—</Text><Text Style=""> </Text><Text Style="">then shut.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">INT. BEDROOM, L-2, 18, NOIDA, UTTAR PRADESH - LATE EVENING - </Text><Text Style="">APRIL 29 (</Text><Text Style="">A DAY LATER</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">A modest room. Walls, newly painted. A single bed in one corner of the room. A small table right next to it, a sheet of paper on it.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul is asleep. He has been so, for the past 24 hours. The doctor had asked to let him be, as he needed his sleep much more than his meals right now.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He stirs in his sleep, groans. And his eyes open. For a few minutes, he can barely move. He forces himself upright, muscles aching. It takes him a while to recognize it as his parents' home.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He remembers losing his balance in the lab. It hurts.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He notices a sheet of paper on the table, and opens it. It's a letter. Or rather a quickly scrawled out notice.</Text></Paragraph><Paragraph Type="Action"><Text Style="">In messy small handwriting is written:</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Dialogue"><Text Style="Italic">The doctor said to knock you down with punches if you ever half-die like that.</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">We got some great news from NASA. Looks like we're going to America. Yay!</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">So, get better fast.</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Text me when you get better.</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">The guy who knocked some sense into you,</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Adithya.</Text></Paragraph><Paragraph Type="Dialogue"/><Paragraph Type="Dialogue"/><Paragraph Type="Dialogue"><Text Style="">Oh, I almost forgot. Eliza dropped by here. That your girlfriend from college?</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Action"><Text Style="">Rahul chuckles. Just as he picks up his phone to text him, his mother comes in, having heard voices from the bedroom.</Text></Paragraph><Paragraph Type="Action"><Text Style="">As soon as she sees her son awake, a relief is exposed on her features. She paces fast to the bed, sitting down on the edge and hugs her son, her hold on him ever more harder.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You're not going to that stinky apartment ever again. That sweet kid told me everything.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul leans in, finding all the stress having eaten him up and swallowed him down. His mother's hug, he felt, could melt it away, </Text><Text Style="Italic">probably.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(starving)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, mum? How long's it been?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So long. Almost three years since you'd gone to that place.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(stomach grumbling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I was talking about how long I have been asleep. I am starving.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flustered)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh. That? Almost a day. Those kids were here the whole night yesterday. Went to school right from here this morning.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She walks offscreen to the kitchen.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Meanwhile, Rahul texts to Aryan and Adithya that he is up and kicking. </Text><Text Style="Italic">Not really.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She comes back, with a plate.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(notices the meal)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I am starving for three days, and you're feeding me </Text><Text Style="Italic">khichdi</Text><Text Style="">? Seriously?</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">The doctor said to start with something light.</Text></Paragraph><Paragraph Type="Action"><Text Style="">As his mother feeds him the first spoon, his eyes accidentally fall on the picture of his dad, on his then study table, back when he used to live here. His eyes fall.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(broken, calm)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I am sorry, mom. I am sorry for not being here when he-</Text></Paragraph><Paragraph Type="Action"><Text Style="">His mother's eyes tear up. Before he is about to finish, she hugs him again, placing the bowl on the side-table.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I'm just glad you're safe, son.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(beat, voice-breaking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Seeing you like that — right after your dad left me forever—</Text></Paragraph><Paragraph Type="Action"><Text Style="">Few minutes pass in embrace.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The bell rings.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(annoyed at being interrupted)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Who's it now?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul's mother hands the food to him, as she rises to walk offscreen to open the house door.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER (O.S.)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hey, it's your </Text><Text Style="Italic">little</Text><Text Style=""> friends.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(teasing tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And Eliza.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs, muttering under his breath)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Eliza? What was she doing with them?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They're not my </Text><Text Style="Italic">little</Text><Text Style=""> friends. They're my... Uhm, science partners.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He barely pauses as his room door is barged open, and Eliza (21, Australian, 5'6'', athletic figure) storms in, and paces right towards where Rahul's sitting.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A slap. Soft, but hard enough.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ELIZA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">What in the world were you thinking? You could have-</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(stops, panting)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You piece of-</Text></Paragraph><Paragraph Type="Action"><Text Style="">Eliza grabs his shirt collar, locking her eyes to his, pulling him up close in anger as if she is about to head-butt him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ELIZA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(gritting her teeth, barely restraining herself)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Cow. Freaking. Shit.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(chuckling to avoid more anger)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hmm... Are we skipping straight to domestic violence, or do I at least get a hello first?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grabbing the attention)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">This isn't Australia. We don't kiss in our parents' home here.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Eliza blinks, exhales sharply, stepping back like she just realized something.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two turn to find Aryan perched on the study table, and Adithya straddling the study chair, arms draped over the backrest.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering loud)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Remind me to keep the camera rolling the next time.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(matter-of-factly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Anyhow, India isn't exactly fair to men filing domestic violence cases.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking at Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I think we shouldn't have said anything. It was quite a free cinema.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul and Eliza blush a little, but Eliza hides away her redness in an instant, Rahul's a little lingering as Eliza settles down into the wooden chair next to the bed, quite closer to Rahul than the other two.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes at the lost spectacle)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, if you two love-birds are done, we've a little NASA talk to do.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya turns on the PC on the study table, after sitting properly on the chair, booting it on as he begins signing in with his Google account.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mumbling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I didn't expect a computer wiz to keep his computer without a password.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, I don't use it nowadays. I used it back when I was 14.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Aryan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">NASA first. And for the record, Eliza and I aren’t a thing.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(dry chuckle)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, </Text><Text Style="Italic">like </Text><Text Style="">we have buttons for our eyes.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(waving it off)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Anyhow, NASA wants us in America in about a month.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya pulls up the e-mail on the computer.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turning back from the PC to look at Rahul)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We posted them their mistake on the given mail. The next day, I woke up to find a mail from the official NASA mail, saying they want us to verify our mail by our identity, saying they couldn't find ours in any scientific directory.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taking on from there)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And we did that, we had to borrow your Aadhar Card as well, and they were shocked, and asked us if we could come to America to help them solve the crisis.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flabbergasted)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They want all three of us in America. Freaking hell, wow... What did you say?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(teasing, trying to keep Rahul on the edge)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We told them that we can't come because we have school.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Rahul is beyond shocked.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You've got to be kidding me? If NASA calls, you go. That's how it works.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shaking his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I was kidding, of course. I told them we couldn't say for sure, but we wouldn't be able to pay for visa and the flight anyhow.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(riding in a swing of emotions)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So? Then?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ELIZA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(finally catching on a little)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Then what, that's what loans are for?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(giving her a sarcastic glare)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Well, we outright denied them that if we had to pay for both the visa and the flight, we'd rather not come.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ELIZA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(deadpan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's so dumb!</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(knowing they're only building up the suspense)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Let 'em cook, Eliza.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(laughs)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They said they'd cover every expense of the journey. They even offered a 5-star hotel stay. Seems like NASA's desperate.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Saying Rahul is excited, is an understatement. He stuffs his mouth with the </Text><Text Style="Italic">khichdi.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(between stuffing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, when are we leaving?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking at the excitement)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Actually, I was thinking going on-</Text></Paragraph><Paragraph Type="Character"><Text Style="">ELIZA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(giving him a glare)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">No time soon. You better stuff yourself up, before you even think of getting out of this house.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(trying to ignore Eliza, playful, as if only Aryan can hear him)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't worry. Who does she think she is - </Text><Text Style="Italic">my mom</Text><Text Style="">?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just as Eliza is about to throw a fit, Rahul's mother enters. Only Adithya notices.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(enjoying the banter)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Well, there </Text><Text Style="Italic">is</Text><Text Style=""> your mom.</Text></Paragraph><Paragraph Type="Character"><Text Style="">RAHUL'S MOTHER</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(having overheard the conversation, giggling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yup, I </Text><Text Style="Italic">am </Text><Text Style="">your mom. So, you are going to hear what </Text><Text Style="Italic">sweet</Text><Text Style=""> Eliza just said.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(thrilled)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, two weeks time. Either you stuff yourself enough that Eliza lets you go or we're going ourselves.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan gets down from the table, Adithya rises from the chair. They walf offscreen, taking away Rahul's mother from the room.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN (O.S.)</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We should let the two love-birds some time. You two better not do some of </Text><Text Style="Italic">that </Text><Text Style="">thing.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(enjoying the tension)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Kissing not allowed as well.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The sound of Eliza's chair creeping a little more closer to the bed, as the two laugh at each other's antics.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE TO BLACK.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Scene Heading"><Text Style="">EXT. FRIDAY MARKET, BADARPUR, NEW DELHI - EARLY EVENING - </Text><Text Style="">MAY 11 (</Text><Text Style="">TWELVE DAYS LATER</Text><Text Style="">)</Text></Paragraph><Paragraph Type="Action"><Text Style="">Shops. All on the road. None legal. Here today. </Text><Text Style="">Gone </Text><Text Style="">tomorrow. The crowd is alive. Loud. A cheap market for the locals, for the middle class.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Who buys local goods? Better to grab something cheap, wear it for a few months, toss it. No point dragging expensive things around all year.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Clothes—for men, for women, for children. Toys. Fast food. Shoes. They say if you look hard enough, you’ll find anything you're looking for.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Not exactly looking for anything, Adithya finds what he didn’t know he was searching for.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Who he didn’t expect to find. Sakshi.</Text></Paragraph><Paragraph Type="Action"><Text Style="">It’s hard to describe what really happens in that moment—when he s</Text><Text Style="">ees her alone - shopping</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">If you could even call it shopping. It was more like scavenging.</Text></Paragraph><Paragraph Type="Action"><Text Style="">And just like that, the chaos of the market fades. The noise, the colors, the motion—none of it matters. She is the only stillness in the storm</Text></Paragraph><Paragraph Type="Action"><Text Style="">His self splits. Not a new occurrence. Ever since the trauma of brotherhood, it had become routine.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The voices only he hears.</Text></Paragraph><Paragraph Type="Character"><Text Style="">HEART</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(gentle, hopeful)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">She's right there. Go talk. It's worth a shot.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MIND</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(cold, rational)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">She's right there. Go away. It's not </Text><Text Style="Italic">even </Text><Text Style="">worth a shot.</Text></Paragraph><Paragraph Type="Action"><Text Style="">His feet refuse to move. His hands? Useless. Just as he debates running — Sakshi waves.</Text></Paragraph><Paragraph Type="Action"><Text Style="">His feet stay rooted for half a second longer than they should. His mind screams at him to walk away. But she waved. And that was enough.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(muttering to himself)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Guess you're winning, Heart!</Text></Paragraph><Paragraph Type="Action"><Text Style="">He waves back. Crosses the road.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Hands in pockets. Indifferent. </Text><Text Style="Italic">Or pretending to be.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(in his mind-scape, to Mind and Heart)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I want you two to stay quiet. This talk is not going to be about failed romance, understood? All I have to do is tell her I am going to America tomorrow.</Text></Paragraph><Paragraph Type="Action"><Text Style="">In his eerie mindscape, he sees the two nod, and reaches up to Sakshi.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He's barely taller than her - 5'7'' over 5'5''. His eyes lock with hers for a second. Too long. He looks away, scanning the crowd as if the neon-lit carts were the most interesting thing in the world.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(gorgeous smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Didn't expect a genius roaming on the streets. That too, this crowd of all places.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales, forcing himself to stay in the moment. He’s not here to get sentimental. Just talk. Just tell her and leave. </Text><Text Style="Italic">Just be the you that only saw her as a friend long back.</Text></Paragraph><Paragraph Type="Action"><Text Style="">That switch had always been easy for him. To mask away himself. But today, for some reason, </Text><Text Style="Italic">it takes a second longer.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(chuckles, scratching his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Well, I didn't think I'd find your majesty here, either.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He puts his hand back in his pockets, his nervousness suppressed under his laid-back attitude.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi laughs back at being called 'majesty'. She nudges her fist forward.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He pulls out his right hand from his pocket. A fist bump. Their smiles show how it had all started. Their first meeting, and the iconic bump.</Text></Paragraph><Paragraph Type="Action"><Text Style="">For a split second, nothing has changed. They’re still the same two kids from back then. But the moment passes, and reality sets in.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The fist bump had been a little something Adithya had introduced to her. </Text><Text Style="Italic">Their little secret</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(still chuckling at the comment)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I didn't become the head-girl and I am already getting the honor.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(genuine smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's reassuring.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(light-hearted)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, as if I am any genius. Just a guy who got interested and worked a </Text><Text Style="Italic">little</Text><Text Style=""> hard.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(walking next to him through the crowd, keeping a distance)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I don't think you're that humble with others. Some in my class go so far as to call you arrogant.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking around at the shops)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="Italic">Bit</Text><Text Style=""> harsh, don't you think? But I guess I have trained for that, being friends with Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(playfully scoffs at the name)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You know... I should have shut Aryan up that day. That ‘slave’ comment? Such a shitty thing to say.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(a clear vein popping on her forehead)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I'd have </Text><Text Style="Italic">killed</Text><Text Style=""> that idiot, if that were outside school.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(laughing a little loud)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He's five inches taller than you. He'd absolutely tower over you.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(tilting her head, pretending to think)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Or maybe just rough him up a little? Push him into a trash can?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(scoffs, waves it off)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I mean, we don't actually have to </Text><Text Style="Italic">kill</Text><Text Style=""> him.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(taking her words back a little)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">But </Text><Text Style="Italic">we</Text><Text Style=""> do have the upper hand... Together we're about 11 feet.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(enjoying himself)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hey, aren't you assuming something here... </Text><Text Style="Italic">He's also my friend.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(scoffs)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, what? You should be on my side, cuz this is for your insult...</Text></Paragraph><Paragraph Type="Action"><Text Style="">A call ringtone blazes from Adithya's pockets as he pulls out his phone.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs, exhales)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Speak of the devil, it's him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(just as he's about to pick up the call)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ooh, let me answer — bet he won’t see it coming.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya hands her the call, knowing Aryan barely touches the love topic on calls, assured that this is probably about tomorrow's flight.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi picks up the call. Puts the phone against her ear, after hurrying him to a place with less crowd.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(over the phone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, all set for tomorrow, dude?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi places a finger on Adithya's lips to gesture him to stay quiet.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She keeps a dead-serious expression, waiting just long enough for Aryan to be confused</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(imitating a rowdy tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Your boy's been kidnapped. If you want him back, wire fifty thousand cash to his account.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mocking, playing along)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Fifty thousand? Oh damn, I don’t think I have that much lying around.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hell with it, as if I'd ever believe that. No kidnapper waits someone to call the kidnapped.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, then deadpan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It's that witch, isn't it, </Text><Text Style="Italic">Iyer</Text><Text Style="">?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pause again, calm voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I know you're </Text><Text Style="Italic">there</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya tries to open his mouth to speak, but is immediately shushed by Sakshi.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(over the phone, the rowdy tone vanishing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't interrupt </Text><Text Style="Italic">us</Text><Text Style="">, okay? I am trying to have a decent conversation with my friend.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(louder)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Tell you what, witch, he's </Text><Text Style="Italic">my</Text><Text Style=""> friend as well.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirk)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If that's how you wanna play this, show up outside the Friday Market, </Text><Text Style="Italic">we</Text><Text Style=""> will see.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Before Aryan protests, she hangs up...</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Was that necessary, Miss Kidnapper?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi chuckles. Hands back his phone.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The phone rings. Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(snorts playfully)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Decline it. Let that idiot come.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I swear, you two should just fight in a boxing ring and get it over with.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya </Text><Text Style="Italic">declines</Text><Text Style=""> the call.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smiles, imagining)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If that ever happens, you're entering the ring with me, I need that 11 feet height.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(mock offended)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh great, I’m just a human ladder to you now?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi just grins.</Text></Paragraph><Paragraph Type="Action"><Text Style="">There is a slight pause. A silence perhaps. Nothing too wild. Just too people looking for what to talk.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Let's go get something to eat.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not having any better ideas)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Sure. A burger? And what about Aryan? He's coming here for the fight, isn't he?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(malicious smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Who cares? Let him be lost for a while. He'd call anyhow.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two start walking towards the shop which is quite famous for its burgers. It's a little far from the main market but the burgers are worth the walk.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya takes the side towards the road, letting her walk near the footpath.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi doesn’t say anything, but there’s a flicker of a glance. A silent acknowledgment? Maybe. Maybe not.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MIND</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(in the mindscape)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">See, folks! Gentleman of the twenty-first century.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Mind in mindscape)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You got some problem?</Text></Paragraph><Paragraph Type="Character"><Text Style="">HEART</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(happy)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ignore the rude freak, Adi. Keep up the talk.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Both Adithya and Sakshi look around here and there for something to talk, continuing to walk.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(distant eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Things still rough in school? You know...</Text></Paragraph><Paragraph Type="Action"><Text Style="">She exhales, gaze dropping for half a second before forcing a small smile.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah... I am still alone pushing for an election for Head Girl.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(understanding)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It'll work out, don't worry... And if it doesn't, you're already Head Girl for me.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shakes her head, pouts)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, and you hardly come to school. So, it barely makes a difference.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(defensive)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's not true-</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(playfully snapping back)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, when was the last time you came to school?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(counting)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">About two weeks ago, I think...</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(eying him)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Still want to justify?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales, raising his hands in fake surrender.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grumbling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Okay, okay, point taken. I'm a </Text><Text Style="Italic">ghost</Text><Text Style=""> student.</Text></Paragraph><Paragraph Type="Action"><Text Style="">They reach the burger shop. A cart - crowded. It may not really be the best location for a burger shop, but the cleanliness - Adithya has checked it many times himself - is much better than the rest of the shops nearby.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya goes up and stands amongst the crowd, waiting for his turn.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi rolls her eyes at his need for proper turns, and grabs his hand, taking him away from the crowd.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(walking around the crowd to the back path, still holding onto his hand)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We won't get a burger in our </Text><Text Style="Italic">whole lives</Text><Text Style=""> if we stood in the crowd.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, yeah, so where are you taking me then?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Turning around and seeing the back path, they both find it blocked. Beneath the blocking is some sort of barrel.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turning to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Get up on it, and ask him to give you the burger.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shakes her head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">We could've easily gotten the burgers </Text><Text Style="Italic">the normal way.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Just do it, will you?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He climbs onto the barrel, and sees at the other side, having a back view of the vendor's cart.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">One burger, please.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grumbling)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ask two... Aren't you gonna eat.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He ignores her. The shopkeeper hands him one.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Now, make another, with nothing but the bun, the </Text><Text Style="Italic">tikki</Text><Text Style="">, and the </Text><Text Style="Italic">chatni.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(groaning)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, how can you even call that burger then?</Text></Paragraph><Paragraph Type="Action"><Text Style="">The shopkeeper gets a little annoyed but hands it to Adithya anyhow.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya bends down to hand her the burger, so as to get down from the barrel.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(handing her the burgers)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Hold mine as well, will ya?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He takes out thirty rupees from his pockets and hands it to the shopkeeper from above the barrel.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He jumps down, and takes back the minimalist burger from her hand.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She eyes his burger like it personally offended her. A long, judging stare.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(deadpan)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You call that a burger?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He looks back at her, confused for a moment, as this is his usual.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He blinks at her, then looks at his burger, genuinely confused about what’s wrong with it.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(finally realizing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, this? I don't like vegies in my burger.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Just as they get out of the crowded shop, Sakshi's phone starts ringing from inside her jeans pocket.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya extends his hand for her to give her burger so that she can take out the phone.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She declines the call.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Who is it? Your dad?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(fake smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I'd not have declined if it were him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(hands her the burger)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He takes a big delicious bite of his burger.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(slight disappointment)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Remember Varun?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pause)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">He asked me out yesterday.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The warm soft burger suddenly feels hard and cold in Adithya's mouth.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(swallowing hard, almost choking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smiles weakly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I think you know what I did already.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pursing his lips)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You said you weren't interested.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She exhales softly, gaze lowered. Then, a quiet nod as he takes a small bite of her burger.</Text></Paragraph><Paragraph Type="Character"><Text Style="">MIND</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(empathizing but cold)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">See, this is your future if you ever pull up your guts. And if you don't, expect just this friendship.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(in mind-space)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Can you shut up? Right now is not about me, it's about </Text><Text Style="Italic">her</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She looks at him, her eyes filled, but keeping the tears in. Her eyes reflect more emotions now than Adithya had ever seen in them.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales, cracked voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">All I ever wanted was... Uhm... Was friends.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya simply kept quiet, letting her go on, letting her continue, his face masking away all emotions, as his eyes locked into hers.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales harder)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Is that too much to ask for? Why can't I be </Text><Text Style="Italic">just</Text><Text Style=""> friends with boys? Why do they have to come around the next week, and seek me like I am some prize for a week-long marathon.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(pauses, wipes off her eye)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">And girls? Those spiteful bitc-</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(stops herself from saying the word, sighs again)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They spread so many rumors just because I am popular amongst the boys.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She clenches her jaw, staring into the distance for a moment, then looks back at him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(soft, but exhausted)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Why?</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales, eyes narrowing slightly. He could lie. He could comfort her. Instead, he chooses the truth.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(calm, empathetic, emotionless tone)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Because you're a rare blend of attractiveness and beauty.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(dry chuckle)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So... Beautiful people don't </Text><Text Style="Italic">deserve</Text><Text Style=""> friends?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(biting back his emotions)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">They do. Perhaps, the way of </Text><Text Style="Italic">searching</Text><Text Style=""> differs.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(genuinely interested, breaking voice)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That is?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I don't know. I am usually on the other side of the beauty line.</Text></Paragraph><Paragraph Type="Action"><Text Style="">A faint bitterness creeps in his voice. He doesn’t say more. He doesn’t need to. Adithya's fist clenches.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(his poetic sense taking him over)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">But I have heard someone say, "Don't look for friends when talking to someone. Just talk. Just be who you are."</Text></Paragraph><Paragraph Type="Action"><Text Style="">She stays quiet for a moment. Maybe thinking. Maybe not wanting to think.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(dry)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Sounds like a poet.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smiling weakly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That someone also exclaimed, "Romantic love is just the next level of friendship. Because it is friends who know the most of who you are."</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi takes in the word, letting them sink in, as she chuckles slightly, having finished her burger, finding it ironic to the modern world, which treats friend-zoning to the opposite of romance.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Not knowing she is doing the same thing as well.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Maybe even ignoring.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(laughs a little)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You made those words just now, didn't you?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(scratching his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah. But I really mean them.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(weak smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You think I am not myself when talking to others?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya sighs, taking in her question, and building upon his answer.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(handing her his handkerchief to wipe away the tears properly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah. I think you limit yourself, you move, you talk, you study, all of it as if you're some role model. You're angry? Let it out in some manner.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(beat)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You're sad? Let it show. Who cares what others think?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(genuinely doubting)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You think the guys who approach me after that would like me to be </Text><Text Style="Italic">just</Text><Text Style=""> friends?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighing, thinking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Not necessarily-</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(cutting him off)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Then, what's the use?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's why I said the second line. This world in its info-dumping has spread the lies that relationships break friendships.</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(deep breath)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If it's not friends who one gets in a relationship with, what's the problem with arranged marriages?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(looking around)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You have fallen prey to that dumping...</Text></Paragraph><Paragraph Type="Action"><Text Style="">She looks away, gripping the handkerchief tightly. But she doesn’t answer.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The silence stretches between them. For a second, he wonders if she’ll argue. But she doesn’t.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(brutal honesty)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">If you wanna live by what the mainstream has to say, so be it. But this is your life, not theirs.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi looks at him. He seems different from the last moment. A glow, perhaps. But she brushes the thought away.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Having finished his monologue, Adithya feels vulnerable. As if he had been using those words to cover himself up. He fiddles with his fingers.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(confused on how she took his words)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Sorry. I think I got carried away.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She watches him fidget, debating whether to call him out for it. But she doesn’t.</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two suddenly notice a mad 6 foot (5'11'' actually) giant stomping towards them as the two brush of their emotions, masking it away from their faces.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan finally reaches the two, and first smacks Adithya in the head.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(furious, to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You dawg! Phone on silent, ignoring my calls? I swear, I’m </Text><Text Style="Italic">killing</Text><Text Style=""> you later.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales sharply, turning to Sakshi like a prosecutor shifting to his next suspect. Adjusts his sleeves like he's about to deliver a closing argument in court.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turning to Sakshi)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You witch! First you call me like a kidnapper and then, challenge me to come to the place. And then, leave away.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales again, turning back to Adithya like a robot.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Your dad called you ten times. And your mother fifteen. Be ready for the whipping of your life.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya pulls out his phone and checks, thinking </Text><Text Style="Italic">he's dead. </Text><Text Style="">To his surprise, the only calls were from Aryan and he rolls his eyes.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(unfiltered)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">You just had to try to make me piss my pants.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(disgust)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Ew. Really, that's how you guys talk? Disgusting.</Text></Paragraph><Paragraph Type="Action"><Text Style="">They exchange a slow, dramatic look — then turn to her in perfect sync.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN AND ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(together)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Forgive us, oh dignified one.</Text></Paragraph><Paragraph Type="Action"><Text Style="">All of them laugh together at the moment. Like crazy madmen. </Text><Text Style="Italic">In this case, madwoman as well</Text><Text Style="">.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Calm silence. Nothing awkward. Just pure serenity.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Told her about tomorrow?</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Told what?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">No. Not yet.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(shakes his head)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">When are you telling? After reaching America.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Wai- Wait, what now? You guys are going America?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(knowing how tense it's going to get)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh... Boy...</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(hesitates)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Uhm. Yeah. We're going to America.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi breaths. Processes. Breaths again. Processes.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flat, dangerously calm)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">...What?</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(seeing the storm brewing)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh... Boy...</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(whispering to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Consider yourself </Text><Text Style="Italic">dead.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi looks at Aryan for a second. Turns to Adithya. Then, back at Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(venom in her tongue)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Smack him hard, will you?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan is not one to listen to others. But he doesn't argue when it comes to getting a good hit on his best-friend.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan shrugs, as if to say "Fair enough" — then swings.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Smack.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(turns to Adithya)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, let's make this clear, shall we?</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(exhales sharply)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">So, all that time you were trying to small-talk, you never thought of going along with 'You are going to America'.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya lost whatever he used to have when he argued the complexities of the universe, and the inexistence of a dietic figure.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He considers running. No. That won’t work. He considers reasoning. No. That’s worse. He accepts fate.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(trying to delay the inevitable)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah... That sounds about right.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(not even looking at Aryan this time)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Smack him. Again. Don't hesitate.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan blinks. Then nods, as if accepting his divine duty.</Text></Paragraph><Paragraph Type="Action"><Text Style="">SMACK.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya gives Aryan a glare - "I'll </Text><Text Style="Italic">kill</Text><Text Style=""> you later."</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rubbing his head to ease the pain)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">That's brutal enough, Sakshi.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi narrows her eyes at Adithya, not willing to take such a statement as a point to back down.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She stares at him. The silence stretches. Then—</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flat, unwavering)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't stop, one more.</Text></Paragraph><Paragraph Type="Action"><Text Style="">This time, Aryan doesn't shrug. Doesn't hesitate.</Text></Paragraph><Paragraph Type="Action"><Text Style="">SMACK.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(having had enough)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Enough is enough.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He exhales sharply, rubbing his temples, then looks at her—dead serious.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(narrowing eyes back at Sakshi)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I could, you know, call you by </Text><Text Style="Italic">that</Text><Text Style=""> name if Sakshi isn't good enough for you to </Text><Text Style="Italic">stop</Text><Text Style="">, lo-</Text></Paragraph><Paragraph Type="Action"><Text Style="">Her shoulders stiffen. Eyes widen. A flicker of real fear — then she snaps.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(alarmed)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Don't you dare-</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(whispering)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Say it... You're </Text><Text Style="Italic">not</Text><Text Style=""> a slave.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(sighs, finally giving in)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Okay, okay... No more smacks...</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya and Sakshi finally relax - both for different reasons.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan is annoyed; he was hoping the name was revealed and Adithya would be smacked even more - fun.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(to Sakshi)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Come on, let's drop you home.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(defensive snort)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">I can go home myself.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(matter-of-factly)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Everyone can do that. Why say with a snort? I was just offering you company.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She blinks, processing. Then, a small shrug — like she never resisted in the first place.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(flustered)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh... Okay... Sure.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(having had enough fun)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Go drop her yourself, </Text><Text Style="Italic">slave</Text><Text Style="">. I have to work on my oscillator.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan begins to walk away, deciding to give Adithya the time of his life with Sakshi. Who knows when he'll get it next time?</Text></Paragraph><Paragraph Type="Action"><Text Style="">Sakshi watches him walk away, considering. Then — smack.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(grinning with satisfaction)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Call him that again, and you'll get it harder.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Aryan merely rolls his eyes, not really in the mood to pick another fight. He continues walking away.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ARYAN</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(raising his hand, gesturing bye)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">See ya.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Adithya looks at her, and then, looks at the far-away Aryan.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(smirking)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">It was not like you had to do that.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(knuckling her fingers like an amateur)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Oh, my hands were </Text><Text Style="Italic">itching</Text><Text Style="">. Besides-</Text></Paragraph><Paragraph Type="Action"><Text Style="">She pauses, letting the words linger, as she turns to him.</Text></Paragraph><Paragraph Type="Character"><Text Style="">SAKSHI</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(innocent smile)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">A wise man told me today to act like myself.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He stares at her, realizing he has no counter.</Text></Paragraph><Paragraph Type="Character"><Text Style="">ADITHYA</Text></Paragraph><Paragraph Type="Parenthetical"><Text Style="">(rolling his eyes)</Text></Paragraph><Paragraph Type="Dialogue"><Text Style="">Yeah, a really </Text><Text Style="Italic">wise</Text><Text Style=""> man!</Text></Paragraph><Paragraph Type="Action"><Text Style="">The two talked and talked. Until they reached her place. The world? It hardly seemed noisy. Time? It was slowing down.</Text></Paragraph><Paragraph Type="Action"><Text Style="">She had him take the fifteen rupees for her burger, despite his protesting.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Had something changed that day? In Adithya's terms, </Text><Text Style="Italic">no one knows. </Text><Text Style="">For Sakshi, </Text><Text Style="Italic">God knows.</Text></Paragraph><Paragraph Type="Action"><Text Style="">He lingers on the door for a second. Then, with a small nod — to himself more than to her — he turns and walks away before her parents came to open the door.</Text></Paragraph><Paragraph Type="Action"><Text Style="">Someday, yes. Not today. It was </Text><Text Style="Italic">too early. Too early</Text><Text Style=""> to meet them.</Text></Paragraph><Paragraph Type="Transition"><Text Style="">FADE OUT.</Text></Paragraph><Paragraph Type="Action"/><Paragraph Type="Action"/></Content><ElementSettings Type="Scene Heading"><FontSpec AdornmentStyle="0" Background="#ffffff" Color="#000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"/><ParagraphSpec Alignment="Left" FirstIndent="0.00" SpaceBefore="24" Spacing="1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" StartsNewPage="No"/></ElementSettings><ListItems/><DisplayBoards><DisplayBoard Height="55" ScrollOrigin="0,0" Type="StoryMap" Width="2032" ZoomLevel="100.000"/><DisplayBoard Height="10000" ScrollOrigin="0,0" Type="Beat" Width="24000" ZoomLevel="100.000"/></DisplayBoards></FinalDraft>